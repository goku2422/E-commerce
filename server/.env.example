# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-client-app.vercel.app

# Database Configuration (MongoDB Atlas Cloud Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_production_jwt_secret_key_change_this
JWT_EXPIRES_IN=7d

# Razorpay Sandbox Credentials (TEST MODE)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Configuration (Optional / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="ApexCart Support <noreply@apexcart.com>"
